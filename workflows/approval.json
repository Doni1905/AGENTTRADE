          "values": [
            {
              "fieldLabel": "Proposal ID",
              "fieldType": "text",
              "requiredField": true,
              "fieldName": "proposal_id"
            },
            {
              "fieldLabel": "Decision",
              "fieldType": "select",
              "fieldOptions": {
                "values": [
                  {
                    "option": "approve"
                  },
                  {
                    "option": "reject"
                  }
                ]
              },
              "requiredField": true,
              "fieldName": "decision"
            },
            {
              "fieldLabel": "Approval code",
              "fieldName": "approval_code",
              "fieldType": "password",
              "requiredField": true
            }
          ]
        },
        "options": {
          "customCss": ":root { font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; } body { background:#f7f8f6; color:#172630; } button[type=submit] { background:#0e584f; border-radius:3px; }"
        }
      }
    },
    {
      "id": "e5d6c1d2-1787-448c-afe1-1e0cd766f642",
      "name": "Verify and commit simulated order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/approval",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({proposal_id:$json.proposal_id,decision:$json.decision,approval_code:$json.approval_code}) }}",
        "options": {}
      }
    }
  ],
  "connections": {
