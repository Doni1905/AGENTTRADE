{
  "name": "AGENTTRADE - human approval for Alpaca paper order",
  "nodes": [
    {
      "id": "932e7d57-b11c-47e9-b8fc-53905955436c",
      "name": "Human approval form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "formTitle": "AGENTTRADE paper-trade approval",
        "formDescription": "Only paper trades. Review proposal ID and details at http://localhost:8000/ledger before entering it here. Paper account only. Never approve an unfamiliar ID.",
