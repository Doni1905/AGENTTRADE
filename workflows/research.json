{
  "name": "AGENTTRADE - research and bounded critique",
  "nodes": [
    {
      "id": "044b6664-e520-4e56-98f7-bf37212ea344",
      "name": "Analyze request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        100
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "agenttrade-analyze",
        "responseMode": "lastNode",
        "options": {},
        "responseData": "firstEntryJson"
      }
    },
    {
      "id": "a98d0998-d4d1-4a2b-8121-4a35c9abd051",
      "name": "Validate and prepare evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/prepare",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "b43afee1-7046-4112-8ea0-a669f494cf2d",
      "name": "1 Retrieval agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        740,
        -80
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Question: \" + $json.question + \"\\nTicker: \" + $json.ticker + \"\\nMode: \" + $json.mode + \"\\n\" + $json.retrieval_instruction + \"\\nFixed evidence: \" + JSON.stringify($json.fixed_evidence) + \"\\nMarket snapshot: \" + JSON.stringify($json.snapshot) }}",
        "options": {
          "systemMessage": "You are the evidence retrieval agent. Follow the mode-specific retrieval instruction exactly. In agentic mode choose Qdrant tool queries yourself. Never invent a source. Return concise evidence with [doc N] citations, publication dates, source, and any insufficiency. In fixed and none mode do not call tools. This is paper-only educational analysis.",
          "maxIterations": 4
        }
      }
    },
    {
      "id": "575e910d-689a-4656-8caf-4ec76a629854",
      "name": "2 Analyst agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1270,
        100
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Question: \" + $(\"Validate and prepare evidence\").item.json.question + \"\\nTicker: \" + $(\"Validate and prepare evidence\").item.json.ticker + \"\\nMode: \" + $(\"Validate and prepare evidence\").item.json.mode + \"\\nSnapshot: \" + JSON.stringify($(\"Validate and prepare evidence\").item.json.snapshot) + \"\\nRetrieval output: \" + $json.output }}",
        "options": {
          "systemMessage": "You are a cautious stock research analyst. Interpret supplied evidence and deterministic market indicators; never invent news, filings, numbers or citations. Cite [doc N] only for source evidence actually present. State as-of dates and uncertainty. This is educational paper-only, not financial advice. Output a decision BUY, SELL or HOLD with reasoning; default HOLD when insufficient."
        }
      }
    },
    {
      "id": "c5a77687-c657-4dae-b437-52699b4ff76f",
      "name": "3 Critic agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1510,
        100
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Question: \" + $(\"Validate and prepare evidence\").item.json.question + \"\\nRetrieved evidence: \" + $(\"Normalize retrieval\").item.json.output + \"\\nAnalyst proposal: \" + $json.output }}",
        "options": {
          "systemMessage": "You are the independent critic. Check citations actually support claims, timestamps, stale market data, weak or conflicting evidence, unsupported confidence and risky paper-order intent. List concrete errors or say PASS. Never modify the ledger."
        }
      }
    },
    {
      "id": "57082bd1-bab9-4790-b9b0-76b23e5659d1",
      "name": "Bounded correction (one pass)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1760,
        100
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Original question: \" + $(\"Validate and prepare evidence\").item.json.question + \"\\nMarket snapshot: \" + JSON.stringify($(\"Validate and prepare evidence\").item.json.snapshot) + \"\\nEvidence: \" + $(\"Normalize retrieval\").item.json.output + \"\\nInitial analysis: \" + $(\"2 Analyst agent\").item.json.output + \"\\nCritique: \" + $json.output }}",
        "options": {
          "systemMessage": "Produce the final corrected answer in exactly one pass. Keep supported evidence and [doc N] citations; remove any unsupported claim and disclose stale or absent data. Never claim a paper order was placed. State educational-only. If critique says PASS, retain the valid initial judgment. No tool, no further iteration."
        }
      }
    },
    {
      "id": "d7918499-a965-4075-82f6-4dd1be83ac1e",
      "name": "Return auditable answer",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2000,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "answer",
              "name": "answer",
              "value": "={{ $json.output }}",
              "type": "string"
            },
            {
              "id": "mode",
              "name": "mode",
              "value": "={{ $(\"Validate and prepare evidence\").item.json.mode }}",
              "type": "string"
            },
            {
              "id": "model",
              "name": "model",
              "value": "={{ $(\"Validate and prepare evidence\").item.json.model }}",
              "type": "string"
            },
            {
              "id": "critic",
              "name": "critic",
              "value": "={{ $(\"3 Critic agent\").item.json.output }}",
              "type": "string"
            },
            {
              "id": "retrieval",
              "name": "retrieval",
              "value": "={{ $(\"Normalize retrieval\").item.json.output }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
