    {
      "id": "acf30834-7827-4eb6-a6c1-e80da3c29e68",
      "name": "Safety and evaluation",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        70,
        -220
      ],
      "parameters": {
        "content": "# AGENTTRADE | paper-only\nResearch webhook routes none/fixed to controlled evidence, agentic to Qdrant-connected retrieval agent. A single analyst, critic and bounded correction follow both branches. No research branch can submit an Alpaca order. Seed Qdrant through POST http://localhost:8000/ingest; configure Ollama/Qdrant credentials after import.",
        "height": 200,
        "width": 620
      }
    },
    {
      "id": "dd714035-2e75-4eaf-9690-ddd57eaec9cd",
      "name": "Route retrieval mode",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.3,
      "position": [
        490,
        100
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "90de24fe-617e-44ac-9386-d87af5303a95",
                    "leftValue": "={{ $json.mode }}",
                    "rightValue": "agentic",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
