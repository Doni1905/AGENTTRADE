        "path": "agenttrade-analyze",
        "responseMode": "lastNode",
        "options": {},
        "responseData": "firstEntryJson"
      }
    },
    {
      "id": "a98d0998-d4d1-4a2b-8121-4a35c9abd051",
      "name": "Validate and prepare evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/prepare",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "b43afee1-7046-4112-8ea0-a669f494cf2d",
      "name": "1 Retrieval agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        740,
        -80
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Question: \" + $json.question + \"\\nTicker: \" + $json.ticker + \"\\nMode: \" + $json.mode + \"\\n\" + $json.retrieval_instruction + \"\\nFixed evidence: \" + JSON.stringify($json.fixed_evidence) + \"\\nMarket snapshot: \" + JSON.stringify($json.snapshot)  + \"\\nEvidence warning: \" + $json.warning + \"\\nCoverage: \" + JSON.stringify($json.evidence_coverage) }}",
        "options": {
          "systemMessage": "You are the evidence retrieval agent. Follow the mode-specific retrieval instruction exactly. In agentic mode choose Qdrant tool queries yourself. Never invent a source. Return concise evidence with [doc N] citations, publication dates, source, and any insufficiency. In fixed and none mode do not call tools. This is paper-only educational analysis.",
          "maxIterations": 4
        }
      }
    },
    {
      "id": "575e910d-689a-4656-8caf-4ec76a629854",
      "name": "2 Analyst agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1270,
        100
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Question: \" + $(\"Validate and prepare evidence\").item.json.question + \"\\nTicker: \" + $(\"Validate and prepare evidence\").item.json.ticker + \"\\nMode: \" + $(\"Validate and prepare evidence\").item.json.mode + \"\\nSnapshot: \" + JSON.stringify($(\"Validate and prepare evidence\").item.json.snapshot) + \"\\nRetrieval output: \" + $json.output  + \"\\nEvidence warning: \" + $(\"Validate and prepare evidence\").item.json.warning + \"\\nCoverage: \" + JSON.stringify($(\"Validate and prepare evidence\").item.json.evidence_coverage) }}",
        "options": {
          "systemMessage": "You are a stock research analyst. Interpret evidence and indicators. Answer the actual question asked. You MUST provide a clear trading decision (BUY, SELL, or HOLD) for the stock being analyzed. Draft for a general reader: begin with an extremely short 1-2 sentence Simple summary in everyday words. Define technical terms."
        }
      }
    },
    {
      "id": "c5a77687-c657-4dae-b437-52699b4ff76f",
      "name": "5 Critic judge",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1990,
        100
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Question: \" + $(\"Validate and prepare evidence\").item.json.question + \"\\nRetrieved evidence: \" + $(\"Normalize retrieval\").item.json.output + \"\\nAnalyst proposal: \" + $(\"2 Analyst agent\").item.json.output + \"\\nBull case: \" + $(\"3 Bull case\").item.json.output + \"\\nBear case: \" + $json.output + \"\\nEvidence warning: \" + $(\"Validate and prepare evidence\").item.json.warning + \"\\nCoverage: \" + JSON.stringify($(\"Validate and prepare evidence\").item.json.evidence_coverage) }}",
        "options": {
          "systemMessage": "You are the independent judge and critic. Check whether the answer addresses the actual question. Ensure the response includes a clear trading decision (BUY, SELL, or HOLD). Ensure the Simple summary is extremely brief (1-2 sentences) and easy for a normal person to understand. Use plain, everyday language in your critique so a non-expert reader can follow your reasoning."
        }
      }
    },
    {
      "id": "57082bd1-bab9-4790-b9b0-76b23e5659d1",
      "name": "Bounded correction (one pass)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        2230,
        100
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Original question: \" + $(\"Validate and prepare evidence\").item.json.question + \"\\nMarket snapshot: \" + JSON.stringify($(\"Validate and prepare evidence\").item.json.snapshot) + \"\\nEvidence: \" + $(\"Normalize retrieval\").item.json.output + \"\\nInitial analysis: \" + $(\"2 Analyst agent\").item.json.output + \"\\nCritique: \" + $json.output  + \"\\nEvidence warning: \" + $(\"Validate and prepare evidence\").item.json.warning + \"\\nCoverage: \" + JSON.stringify($(\"Validate and prepare evidence\").item.json.evidence_coverage) + \"\\nUser owns stock: \" + $(\"Validate and prepare evidence\").item.json.user_owns_stock }}",
        "options": {
          "systemMessage": "Produce the final corrected answer in exactly one pass. Keep supported evidence and [doc N] citations. CRITICAL: Do not invent or assume the current year. Always use exact as-of dates. Never claim an order was placed. Address the exact user question.\nCRITICAL INSTRUCTION: You MUST output your response in EXACTLY the following structure, with no exceptions:\n\nSimple summary:\n<Extremely short, 1-2 sentences in simple, everyday language. Directly answer the question asked. If the user asks for the best stock to buy, explicitly name the ticker you recommend here.>\n\nTechnical details:\nDecision: [BUY, SELL, or HOLD. You MUST output exactly one of these three decisions. If you are recommending a stock from a general question, output BUY.]\n<evidence, dates, citations>"
        }
      }
    },
    {
      "id": "d7918499-a965-4075-82f6-4dd1be83ac1e",
      "name": "Return auditable answer",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2460,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "answer",
              "name": "answer",
              "value": "={{ $json.output }}",
              "type": "string"
            },
            {
              "id": "simple-summary",
              "name": "simple_summary",
              "value": "={{ ($json.output.match(/Simple summary:\\s*([\\s\\S]*?)\\n+\\s*Technical details:/i) || [])[1] || \"\" }}",
              "type": "string"
            },
            {
              "id": "technical-detail",
              "name": "technical_detail",
              "value": "={{ ($json.output.match(/Technical details:\\s*([\\s\\S]*)/i) || [])[1] || \"\" }}",
              "type": "string"
            },
            {
              "id": "mode",
