              "id": "baseline-output",
              "name": "output",
              "value": "={{ $json.mode === \"none\" ? \"No retrieved evidence. State uncertainty.\" : JSON.stringify($json.fixed_evidence) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
