    {
      "id": "b92c309d-e2ce-4ff1-9b0f-3226549f7616",
      "name": "3 Bull case",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1510,
        100
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Question: \" + $(\"Validate and prepare evidence\").item.json.question + \"\\nTicker: \" + $(\"Validate and prepare evidence\").item.json.ticker + \"\\nAnalyst conclusion: \" + $(\"2 Analyst agent\").item.json.output + \"\\nRetrieved evidence: \" + $(\"Normalize retrieval\").item.json.output + \"\\nCoverage: \" + JSON.stringify($(\"Validate and prepare evidence\").item.json.evidence_coverage) }}",
        "options": {
          "systemMessage": "Make the strongest short evidence-grounded bull case for the ticker, even if the analyst concluded HOLD. Give at most two claims with actual supplied source IDs and dates. If evidence does not support a bull case, say insufficient evidence. Never infer a trade order or fabricate news. Use everyday words alongside each financial term (explain terms briefly inline), so the final judge can build a summary a non-finance reader understands. Do not infer valuation from price trends alone."
        }
      }
    },
